{
  "name": "@endo/agentry",
  "version": "0.1.0",
  "private": true,
  "description": "Shared infrastructure for building agentic harnesses across endo packages",
  "keywords": [],
  "author": "Endo contributors",
  "license": "Apache-2.0",
  "homepage": "https://github.com/endojs/endo/tree/master/packages/agentry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/endojs/endo.git",
    "directory": "packages/agentry"
  },
  "bugs": {
    "url": "https://github.com/endojs/endo/issues"
  },
  "type": "module",
  "exports": {
    "./optimizer/ax-harness": "./src/optimizer/ax-harness.js",
    "./optimizer/trace-metric": "./src/optimizer/trace-metric.js",
    "./optimizer/model-matrix": "./src/optimizer/model-matrix.js",
    "./optimizer/check-prompt-baseline": "./src/optimizer/check-prompt-baseline.js",
    "./optimizer/optimize-prompt": "./src/optimizer/optimize-prompt.js",
    "./optimizer/init": "./src/optimizer/init.js",
    "./smallcaps": "./src/smallcaps/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "exit 0",
    "lint": "yarn lint:eslint",
    "lint-fix": "yarn lint:eslint --fix",
    "lint:eslint": "eslint '**/*.js'",
    "prepack": "exit 0",
    "test": "exit 0"
  },
  "dependencies": {
    "@ax-llm/ax": "^21.0.0"
  },
  "devDependencies": {
    "@endo/init": "workspace:^",
    "@endo/lockdown": "workspace:^",
    "@endo/ses-ava": "workspace:^",
    "ava": "catalog:dev",
    "eslint": "catalog:dev"
  },
  "files": [
    "./*.d.ts",
    "./*.js",
    "./*.map",
    "LICENSE*",
    "SECURITY*",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "eslintConfig": {
    "extends": [
      "plugin:@endo/internal"
    ]
  },
  "ava": {
    "files": [
      "test/**/*.test.*"
    ],
    "timeout": "2m"
  }
}
